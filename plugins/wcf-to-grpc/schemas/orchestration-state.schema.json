{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "./orchestration-state.schema.json",
  "title": "WCF to gRPC code-only orchestration state",
  "description": "Resumable state for code generation through repository-local build/tests and offline handoff. Operational deployment, traffic, parity, cutover, rollback execution, and retirement are outside this state machine.",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": "2.2.0"
    },
    "artifactType": {
      "const": "orchestration-state"
    },
    "runId": {
      "type": "string",
      "pattern": "^ORUN-[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "generation": {
      "$ref": "./common.schema.json#/$defs/generation"
    },
    "repository": {
      "$ref": "#/$defs/repository"
    },
    "outputDirectory": {
      "$ref": "./common.schema.json#/$defs/relativePath"
    },
    "targetRuntime": {
      "$ref": "./common.schema.json#/$defs/resolvedString"
    },
    "solutionLayout": {
      "$ref": "./common.schema.json#/$defs/solutionLayout"
    },
    "permissions": {
      "$ref": "#/$defs/permissions"
    },
    "outcome": {
      "enum": [
        "in-progress",
        "blocked",
        "code-complete"
      ]
    },
    "stages": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/stage"
      },
      "minItems": 10,
      "maxItems": 10,
      "allOf": [
        {
          "contains": {
            "properties": {
              "stage": {
                "const": "intake"
              }
            },
            "required": [
              "stage"
            ]
          }
        },
        {
          "contains": {
            "properties": {
              "stage": {
                "const": "inventory"
              }
            },
            "required": [
              "stage"
            ]
          }
        },
        {
          "contains": {
            "properties": {
              "stage": {
                "const": "decision-preparation"
              }
            },
            "required": [
              "stage"
            ]
          }
        },
        {
          "contains": {
            "properties": {
              "stage": {
                "const": "mapping"
              }
            },
            "required": [
              "stage"
            ]
          }
        },
        {
          "contains": {
            "properties": {
              "stage": {
                "const": "specification"
              }
            },
            "required": [
              "stage"
            ]
          }
        },
        {
          "contains": {
            "properties": {
              "stage": {
                "const": "consolidated-review"
              }
            },
            "required": [
              "stage"
            ]
          }
        },
        {
          "contains": {
            "properties": {
              "stage": {
                "const": "publication"
              }
            },
            "required": [
              "stage"
            ]
          }
        },
        {
          "contains": {
            "properties": {
              "stage": {
                "const": "implementation"
              }
            },
            "required": [
              "stage"
            ]
          }
        },
        {
          "contains": {
            "properties": {
              "stage": {
                "const": "final-local-checkpoint"
              }
            },
            "required": [
              "stage"
            ]
          }
        },
        {
          "contains": {
            "properties": {
              "stage": {
                "const": "offline-handoff"
              }
            },
            "required": [
              "stage"
            ]
          }
        }
      ]
    },
    "artifacts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/artifactState"
      }
    },
    "blockingItems": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/blockingItem"
      }
    },
    "attemptHistory": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/attempt"
      },
      "minItems": 1
    },
    "currentAttemptId": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^ATT-[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        {
          "type": "null"
        }
      ]
    },
    "waves": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/wave"
      }
    },
    "finalCheckpoint": {
      "oneOf": [
        {
          "$ref": "#/$defs/finalCheckpoint"
        },
        {
          "type": "null"
        }
      ]
    },
    "approvalsObserved": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/approvalObservation"
      }
    },
    "reviewBundle": {
      "oneOf": [
        {
          "$ref": "#/$defs/reviewBundleState"
        },
        {
          "type": "null"
        }
      ]
    },
    "observations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/observation"
      }
    },
    "nextRequiredAction": {
      "$ref": "#/$defs/nextRequiredAction"
    }
  },
  "required": [
    "schemaVersion",
    "artifactType",
    "runId",
    "generation",
    "repository",
    "outputDirectory",
    "targetRuntime",
    "solutionLayout",
    "permissions",
    "outcome",
    "stages",
    "artifacts",
    "blockingItems",
    "attemptHistory",
    "currentAttemptId",
    "waves",
    "finalCheckpoint",
    "approvalsObserved",
    "reviewBundle",
    "observations",
    "nextRequiredAction"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "outcome": {
            "const": "code-complete"
          }
        },
        "required": [
          "outcome"
        ]
      },
      "then": {
        "properties": {
          "finalCheckpoint": {
            "type": "object",
            "properties": {
              "affectedBuildsPassed": {
                "const": true
              },
              "requiredLocalTestsPassed": {
                "const": true
              },
              "status": {
                "const": "passed"
              }
            }
          },
          "stages": {
            "allOf": [
              {
                "contains": {
                  "properties": {
                    "stage": {
                      "const": "final-local-checkpoint"
                    },
                    "status": {
                      "const": "complete"
                    }
                  },
                  "required": [
                    "stage",
                    "status"
                  ]
                }
              },
              {
                "contains": {
                  "properties": {
                    "stage": {
                      "const": "offline-handoff"
                    },
                    "status": {
                      "const": "complete"
                    }
                  },
                  "required": [
                    "stage",
                    "status"
                  ]
                }
              }
            ]
          },
          "artifacts": {
            "contains": {
              "properties": {
                "artifact": {
                  "properties": {
                    "artifactType": {
                      "const": "code-handoff"
                    }
                  },
                  "required": [
                    "artifactType"
                  ]
                },
                "freshness": {
                  "const": "current"
                }
              },
              "required": [
                "artifact",
                "freshness"
              ]
            }
          },
          "nextRequiredAction": {
            "properties": {
              "owner": {
                "const": "none"
              }
            }
          }
        }
      }
    }
  ],
  "additionalProperties": false,
  "$defs": {
    "repository": {
      "type": "object",
      "properties": {
        "root": {
          "$ref": "./common.schema.json#/$defs/relativePath"
        },
        "kind": {
          "enum": [
            "unknown",
            "service-host",
            "client-only",
            "mixed"
          ]
        },
        "scope": {
          "type": "object",
          "properties": {
            "summary": {
              "type": "string",
              "minLength": 1
            },
            "includeIds": {
              "$ref": "./common.schema.json#/$defs/idArray"
            },
            "excludeIds": {
              "$ref": "./common.schema.json#/$defs/idArray"
            }
          },
          "required": [
            "summary",
            "includeIds",
            "excludeIds"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "root",
        "kind",
        "scope"
      ],
      "additionalProperties": false
    },
    "permissions": {
      "type": "object",
      "description": "Code-only permissions. Network and optional GitHub Issue mutation default to false.",
      "properties": {
        "allowNetwork": {
          "type": "boolean"
        },
        "allowGitHubMutation": {
          "type": "boolean"
        }
      },
      "required": [
        "allowNetwork",
        "allowGitHubMutation"
      ],
      "additionalProperties": false
    },
    "stageName": {
      "enum": [
        "intake",
        "inventory",
        "decision-preparation",
        "mapping",
        "specification",
        "consolidated-review",
        "publication",
        "implementation",
        "final-local-checkpoint",
        "offline-handoff"
      ]
    },
    "stage": {
      "type": "object",
      "properties": {
        "stage": {
          "$ref": "#/$defs/stageName"
        },
        "status": {
          "enum": [
            "not-started",
            "in-progress",
            "blocked",
            "complete",
            "stale",
            "skipped"
          ]
        },
        "owner": {
          "type": "string",
          "minLength": 1
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        },
        "resultSummary": {
          "type": "string",
          "minLength": 1
        },
        "artifactPaths": {
          "type": "array",
          "items": {
            "$ref": "./common.schema.json#/$defs/relativePath"
          },
          "uniqueItems": true
        },
        "blockingItemIds": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^BLK-[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "uniqueItems": true
        }
      },
      "required": [
        "stage",
        "status",
        "owner",
        "updatedAt",
        "resultSummary",
        "artifactPaths",
        "blockingItemIds"
      ],
      "additionalProperties": false
    },
    "artifactState": {
      "type": "object",
      "properties": {
        "artifact": {
          "$ref": "./common.schema.json#/$defs/artifactRef"
        },
        "path": {
          "$ref": "./common.schema.json#/$defs/relativePath"
        },
        "sourceDigest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "semanticDigest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "approvalState": {
          "enum": [
            "draft",
            "review-requested",
            "approved",
            "rejected",
            "superseded",
            "not-applicable"
          ]
        },
        "freshness": {
          "enum": [
            "current",
            "stale",
            "missing"
          ]
        },
        "observedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "artifact",
        "path",
        "approvalState",
        "freshness",
        "observedAt"
      ],
      "additionalProperties": false
    },
    "blockingItem": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^BLK-[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "kind": {
          "enum": [
            "missing-input",
            "invalid-input",
            "stale-artifact",
            "unresolved-decision",
            "missing-approval",
            "missing-confirmation",
            "ownership-conflict",
            "dependency-cycle",
            "unreconciled-checkpoint",
            "local-validation-failure",
            "evidence-gap",
            "missing-permission"
            ,
            "execution-capability"
          ]
        },
        "blocks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/stageName"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "requiredIds": {
          "$ref": "./common.schema.json#/$defs/idArray"
        },
        "whyBlocking": {
          "type": "string",
          "minLength": 1
        },
        "owner": {
          "type": "string",
          "minLength": 1
        },
        "nextAction": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "id",
        "kind",
        "blocks",
        "requiredIds",
        "whyBlocking",
        "owner",
        "nextAction"
      ],
      "additionalProperties": false
    },
    "wave": {
      "type": "object",
      "properties": {
        "wave": {
          "type": "integer",
          "minimum": 1
        },
        "phaseId": {
          "type": "string",
          "pattern": "^PHS-[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "integrationCheckpoint": {
          "type": "boolean"
        },
        "checkpointReportPath": {
          "$ref": "./common.schema.json#/$defs/relativePath"
        },
        "checkpointState": {
          "enum": [
            "not-required",
            "pending",
            "reconciled",
            "unresolved"
          ]
        },
        "packages": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/wavePackage"
          },
          "minItems": 1
        },
        "ownershipConflicts": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "wave",
        "phaseId",
        "integrationCheckpoint",
        "checkpointState",
        "packages",
        "ownershipConflicts"
      ],
      "additionalProperties": false
    },
    "wavePackage": {
      "type": "object",
      "properties": {
        "workPackageId": {
          "type": "string",
          "pattern": "^WP-[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "dispatchMode": {
          "enum": [
            "parallel-eligible",
            "sequential"
          ]
        },
        "dispatchState": {
          "enum": [
            "not-dispatched",
            "handed-off",
            "reported",
            "blocked"
          ]
        },
        "reportPath": {
          "$ref": "./common.schema.json#/$defs/relativePath"
        },
        "reportStatus": {
          "enum": [
            "completed",
            "partial",
            "blocked",
            "absent"
          ]
        },
        "exclusiveWritePaths": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "capabilityCheck": {
          "$ref": "#/$defs/capabilityCheck"
        }
      },
      "required": [
        "workPackageId",
        "dispatchMode",
        "dispatchState",
        "reportStatus",
        "exclusiveWritePaths",
        "capabilityCheck"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "dispatchState": {
                "enum": [
                  "handed-off",
                  "reported"
                ]
              }
            },
            "required": [
              "dispatchState"
            ]
          },
          "then": {
            "properties": {
              "capabilityCheck": {
                "properties": {
                  "capable": {
                    "const": true
                  },
                  "fileEdit": {
                    "const": true
                  },
                  "processExecution": {
                    "const": true
                  }
                }
              }
            }
          }
        }
      ],
      "additionalProperties": false
    },
    "capabilityCheck": {
      "type": "object",
      "properties": {
        "checkedAt": {
          "type": "string",
          "format": "date-time"
        },
        "capable": {
          "type": "boolean"
        },
        "fileRead": {
          "type": "boolean"
        },
        "fileEdit": {
          "type": "boolean"
        },
        "processExecution": {
          "type": "boolean"
        },
        "git": {
          "type": "boolean"
        },
        "dotnetSdk": {
          "$ref": "./common.schema.json#/$defs/resolvedString"
        },
        "network": {
          "$ref": "./common.schema.json#/$defs/resolvedBoolean"
        },
        "credentialMechanism": {
          "$ref": "./common.schema.json#/$defs/resolvedString",
          "description": "Non-secret description of the available credential mechanism, or why credentials are not applicable."
        },
        "missingCapabilities": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      },
      "required": [
        "checkedAt",
        "capable",
        "fileRead",
        "fileEdit",
        "processExecution",
        "git",
        "dotnetSdk",
        "network",
        "credentialMechanism",
        "missingCapabilities"
      ],
      "additionalProperties": false
    },
    "attempt": {
      "type": "object",
      "properties": {
        "attemptId": {
          "type": "string",
          "pattern": "^ATT-[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "workPackageId": {
          "type": "string",
          "pattern": "^WP-[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "reportPath": {
          "$ref": "./common.schema.json#/$defs/relativePath"
        },
        "startedAt": {
          "type": "string",
          "format": "date-time"
        },
        "outcome": {
          "enum": [
            "in-progress",
            "blocked",
            "partial",
            "completed"
          ]
        },
        "resolvedBlockerIds": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^BLK-[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "uniqueItems": true
        },
        "supersedesAttemptId": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^ATT-[a-z0-9]+(?:-[a-z0-9]+)*$"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "attemptId",
        "workPackageId",
        "reportPath",
        "startedAt",
        "outcome",
        "resolvedBlockerIds",
        "supersedesAttemptId"
      ],
      "additionalProperties": false
    },
    "finalCheckpoint": {
      "type": "object",
      "properties": {
        "workPackageId": {
          "type": "string",
          "pattern": "^WP-[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "reportPath": {
          "$ref": "./common.schema.json#/$defs/relativePath"
        },
        "validatedRevision": {
          "$ref": "./common.schema.json#/$defs/resolvedString"
        },
        "affectedBuildsPassed": {
          "type": "boolean"
        },
        "requiredLocalTestsPassed": {
          "type": "boolean"
        },
        "commandsExecuted": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "status": {
          "enum": [
            "pending",
            "passed",
            "failed",
            "blocked",
            "stale"
          ]
        }
      },
      "required": [
        "workPackageId",
        "reportPath",
        "validatedRevision",
        "affectedBuildsPassed",
        "requiredLocalTestsPassed",
        "commandsExecuted",
        "status"
      ],
      "additionalProperties": false
    },
    "approvalObservation": {
      "type": "object",
      "properties": {
        "subject": {
          "enum": [
            "migration-spec",
            "migration-review",
            "decision-bundle",
            "work-package",
            "issue-preview"
          ]
        },
        "subjectId": {
          "$ref": "./common.schema.json#/$defs/stableId"
        },
        "state": {
          "enum": [
            "absent",
            "review-requested",
            "approved",
            "rejected"
          ]
        },
        "recordedIn": {
          "$ref": "./common.schema.json#/$defs/relativePath"
        },
        "observedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "subject",
        "subjectId",
        "state",
        "recordedIn",
        "observedAt"
      ],
      "additionalProperties": false
    },
    "reviewBundleState": {
      "type": "object",
      "properties": {
        "path": {
          "$ref": "./common.schema.json#/$defs/relativePath"
        },
        "artifactId": {
          "type": "string",
          "pattern": "^MREV-[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "semanticDigest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "digestAlgorithmVersion": {
          "$ref": "./common.schema.json#/$defs/digestAlgorithmVersion"
        },
        "freshness": {
          "enum": [
            "current",
            "stale",
            "missing"
          ]
        },
        "decisionApprovalState": {
          "enum": [
            "not-requested",
            "pending",
            "partial",
            "recorded"
          ]
        },
        "specificationApprovalState": {
          "enum": [
            "not-requested",
            "pending",
            "recorded"
          ]
        },
        "approvedDecisionIds": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^DEC-[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "uniqueItems": true
        },
        "approvedWorkPackageIds": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^WP-[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "uniqueItems": true
        }
      },
      "required": [
        "path",
        "artifactId",
        "semanticDigest",
        "digestAlgorithmVersion",
        "freshness",
        "decisionApprovalState",
        "specificationApprovalState",
        "approvedDecisionIds",
        "approvedWorkPackageIds"
      ],
      "additionalProperties": false
    },
    "observation": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^OBS-[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "kind": {
          "enum": [
            "prompt-injection-attempt",
            "artifact-conflict",
            "assumed-default",
            "refusal",
            "legacy-state-migration"
          ]
        },
        "source": {
          "$ref": "./common.schema.json#/$defs/relativePath"
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "actionTaken": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "id",
        "kind",
        "source",
        "summary",
        "actionTaken"
      ],
      "additionalProperties": false
    },
    "nextRequiredAction": {
      "type": "object",
      "properties": {
        "owner": {
          "enum": [
            "orchestrator",
            "operator",
            "reviewer",
            "wcf-codebase-analyst",
            "wcf-migration-decision-interviewer",
            "wcf-to-grpc-mapper",
            "grpc-migration-architect",
            "grpc-migration-issue-publisher",
            "grpc-migration-implementer",
            "grpc-code-handoff-author",
            "none"
          ]
        },
        "action": {
          "type": "string",
          "minLength": 1
        },
        "blockingItemIds": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^BLK-[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "uniqueItems": true
        }
      },
      "required": [
        "owner",
        "action",
        "blockingItemIds"
