{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "./migration-review.schema.json",
  "title": "WCF to gRPC consolidated migration review",
  "description": "Digest-bound review bundle for proposed code decisions, architecture, contracts, roadmap, and repository-local work packages. Operational topics are non-executable offline handoff guidance; publication remains separately confirmed.",
  "allOf": [
    {
      "$ref": "./common.schema.json#/$defs/artifactBase"
    },
    {
      "type": "object",
      "properties": {
        "artifactType": {
          "const": "migration-review"
        },
        "artifactId": {
          "type": "string",
          "pattern": "^MREV-[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "sourceArtifacts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/sourceArtifact"
          },
          "minItems": 4,
          "maxItems": 4,
          "allOf": [
            {
              "contains": {
                "properties": {
                  "artifact": {
                    "properties": {
                      "artifactType": {
                        "const": "inventory"
                      }
                    },
                    "required": [
                      "artifactType"
                    ]
                  }
                },
                "required": [
                  "artifact"
                ]
              },
              "minContains": 1,
              "maxContains": 1
            },
            {
              "contains": {
                "properties": {
                  "artifact": {
                    "properties": {
                      "artifactType": {
                        "const": "decision-log"
                      }
                    },
                    "required": [
                      "artifactType"
                    ]
                  }
                },
                "required": [
                  "artifact"
                ]
              },
              "minContains": 1,
              "maxContains": 1
            },
            {
              "contains": {
                "properties": {
                  "artifact": {
                    "properties": {
                      "artifactType": {
                        "const": "mapping-result"
                      }
                    },
                    "required": [
                      "artifactType"
                    ]
                  }
                },
                "required": [
                  "artifact"
                ]
              },
              "minContains": 1,
              "maxContains": 1
            },
            {
              "contains": {
                "properties": {
                  "artifact": {
                    "properties": {
                      "artifactType": {
                        "const": "migration-spec"
                      }
                    },
                    "required": [
                      "artifactType"
                    ]
                  }
                },
                "required": [
                  "artifact"
                ]
              },
              "minContains": 1,
              "maxContains": 1
            }
          ],
          "uniqueItems": true
        },
        "semanticDigest": {
          "$ref": "./common.schema.json#/$defs/semanticDigest"
        },
        "digestAlgorithmVersion": {
          "$ref": "./common.schema.json#/$defs/digestAlgorithmVersion"
        },
        "decisionReviews": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/decisionReview"
          }
        },
        "architectureSummary": {
          "$ref": "#/$defs/summary"
        },
        "contractSummary": {
          "$ref": "#/$defs/summary"
        },
        "roadmapSummary": {
          "$ref": "#/$defs/summary"
        },
        "workPackageIds": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^WP-[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "uniqueItems": true
        },
        "renderedArtifacts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/renderedArtifact"
          },
          "minItems": 4,
          "allOf": [
            {
              "contains": {
                "properties": {
                  "kind": {
                    "const": "architecture"
                  }
                },
                "required": [
                  "kind"
                ]
              },
              "minContains": 1
            },
            {
              "contains": {
                "properties": {
                  "kind": {
                    "const": "contract"
                  }
                },
                "required": [
                  "kind"
                ]
              },
              "minContains": 1
            },
            {
              "contains": {
                "properties": {
                  "kind": {
                    "const": "roadmap"
                  }
                },
                "required": [
                  "kind"
                ]
              },
              "minContains": 1
            },
            {
              "contains": {
                "properties": {
                  "kind": {
                    "const": "work-package"
                  }
                },
                "required": [
                  "kind"
                ]
              },
              "minContains": 1
            }
          ]
        },
        "blockingDecisionIds": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^DEC-[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "uniqueItems": true
        },
        "offlineHandoffItems": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/offlineHandoffItem"
          }
        },
        "outOfScopeActions": {
          "type": "array",
          "items": {
            "enum": [
              "deployment",
              "environment-provisioning",
              "protected-traffic",
              "production-access",
              "environment-parity-validation",
              "consumer-cutover",
              "live-rollback",
              "wcf-retirement"
            ]
          },
          "minItems": 8,
          "maxItems": 8,
          "uniqueItems": true
        },
        "approvalScope": {
          "$ref": "#/$defs/approvalScope"
        }
      },
      "required": [
        "sourceArtifacts",
        "semanticDigest",
        "digestAlgorithmVersion",
        "decisionReviews",
        "architectureSummary",
        "contractSummary",
        "roadmapSummary",
        "workPackageIds",
        "renderedArtifacts",
        "blockingDecisionIds",
        "offlineHandoffItems",
        "outOfScopeActions",
        "approvalScope"
      ]
    }
  ],
  "unevaluatedProperties": false,
  "$defs": {
    "sourceArtifact": {
      "type": "object",
      "properties": {
        "artifact": {
          "$ref": "./common.schema.json#/$defs/artifactRef"
        },
        "semanticDigest": {
          "$ref": "./common.schema.json#/$defs/semanticDigest"
        },
        "digestAlgorithmVersion": {
          "$ref": "./common.schema.json#/$defs/digestAlgorithmVersion"
        }
      },
      "required": [
        "artifact",
        "semanticDigest",
        "digestAlgorithmVersion"
      ],
      "additionalProperties": false
    },
    "decisionReview": {
      "type": "object",
      "properties": {
        "decisionId": {
          "type": "string",
          "pattern": "^DEC-[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "selectedOptionId": {
          "type": "string",
          "pattern": "^OPT-[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "interactionClass": {
          "enum": [
            "agent-proposed",
            "review-required",
            "immediate-answer-required"
          ]
        },
        "recommendation": {
          "type": "string",
          "minLength": 1
        },
        "rationale": {
          "type": "string",
          "minLength": 1
        },
        "confidence": {
          "enum": [
            "high",
            "medium",
            "low"
          ]
        },
        "assumptions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "alternatives": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "consequences": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "evidenceIds": {
          "$ref": "./common.schema.json#/$defs/evidenceIdArray"
        }
      },
      "required": [
        "decisionId",
        "selectedOptionId",
        "interactionClass",
        "recommendation",
        "rationale",
        "confidence",
        "assumptions",
        "alternatives",
        "consequences",
        "evidenceIds"
      ],
      "additionalProperties": false
    },
    "summary": {
      "type": "object",
      "properties": {
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "includedIds": {
          "$ref": "./common.schema.json#/$defs/idArray"
        },
        "unresolvedIds": {
          "$ref": "./common.schema.json#/$defs/idArray"
        }
      },
      "required": [
        "summary",
        "includedIds",
        "unresolvedIds"
      ],
      "additionalProperties": false
    },
    "renderedArtifact": {
      "type": "object",
      "properties": {
        "kind": {
          "enum": [
            "architecture",
            "contract",
            "roadmap",
            "work-package"
          ]
        },
        "path": {
          "$ref": "./common.schema.json#/$defs/relativePath"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "boundIds": {
          "$ref": "./common.schema.json#/$defs/idArray"
        },
        "contentDigest": {
          "$ref": "./common.schema.json#/$defs/semanticDigest"
        }
      },
      "required": [
        "kind",
        "path",
        "title",
        "boundIds",
        "contentDigest"
      ],
      "additionalProperties": false
    },
    "offlineHandoffItem": {
      "type": "object",
      "properties": {
        "decisionId": {
          "type": "string",
          "pattern": "^DEC-[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "gate": {
          "enum": [
            "implementation",
            "final-local-checkpoint",
            "offline-handoff"
          ]
        },
        "nextAction": {
          "type": "string",
          "minLength": 1
        },
        "owner": {
          "$ref": "./common.schema.json#/$defs/resolvedString"
        }
      },
      "required": [
        "decisionId",
        "gate",
        "nextAction",
        "owner"
      ],
      "additionalProperties": false
    },
    "approvalScope": {
      "type": "object",
      "properties": {
        "decisionIds": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^DEC-[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "uniqueItems": true
        },
        "workPackageIds": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^WP-[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "uniqueItems": true
        },
        "excludedActions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true
        }
      },
      "required": [
        "decisionIds",
        "workPackageIds",
        "excludedActions"
      ],
      "additionalProperties": false
    }
  }
}
