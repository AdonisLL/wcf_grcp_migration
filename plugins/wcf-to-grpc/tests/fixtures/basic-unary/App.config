<?xml version="1.0" encoding="utf-8" ?>
<configuration>
  <system.serviceModel>
    <bindings>
      <basicHttpBinding>
        <binding name="CustomerBasicHttp" maxReceivedMessageSize="65536">
          <security mode="TransportCredentialOnly">
            <transport clientCredentialType="Windows" />
          </security>
        </binding>
      </basicHttpBinding>
    </bindings>
    <services>
      <service name="Fixtures.BasicUnary.CustomerService">
        <host>
          <baseAddresses>
            <add baseAddress="http://localhost:8123/customers" />
          </baseAddresses>
        </host>
        <endpoint address="" binding="basicHttpBinding"
                  bindingConfiguration="CustomerBasicHttp"
                  contract="Fixtures.BasicUnary.ICustomerService" />
      </service>
    </services>
    <client>
      <endpoint name="CustomerClient"
                address="http://localhost:8123/customers"
                binding="basicHttpBinding"
                bindingConfiguration="CustomerBasicHttp"
                contract="Fixtures.BasicUnary.ICustomerService" />
    </client>
  </system.serviceModel>
</configuration>
