<?xml version="1.0" encoding="utf-8" ?>
<configuration>
  <system.serviceModel>
    <bindings>
      <netTcpBinding>
        <binding name="ReliableDuplex" receiveTimeout="00:20:00">
          <reliableSession enabled="true" ordered="true" inactivityTimeout="00:10:00" />
          <security mode="Transport">
            <transport clientCredentialType="Windows" protectionLevel="EncryptAndSign" />
          </security>
        </binding>
      </netTcpBinding>
      <basicHttpBinding>
        <binding name="StreamedArchive"
                 transferMode="Streamed"
                 maxReceivedMessageSize="67108864"
                 sendTimeout="00:10:00" />
      </basicHttpBinding>
    </bindings>
    <services>
      <service name="Fixtures.DuplexHighRisk.DispatchService">
        <host>
          <baseAddresses>
            <add baseAddress="net.tcp://localhost:8125/dispatch" />
          </baseAddresses>
        </host>
        <endpoint address="" binding="netTcpBinding"
                  bindingConfiguration="ReliableDuplex"
                  contract="Fixtures.DuplexHighRisk.IDispatchService" />
      </service>
      <service name="Fixtures.DuplexHighRisk.ArchiveTransferService">
        <host>
          <baseAddresses>
            <add baseAddress="http://localhost:8126/archive" />
          </baseAddresses>
        </host>
        <endpoint address="" binding="basicHttpBinding"
                  bindingConfiguration="StreamedArchive"
                  contract="Fixtures.DuplexHighRisk.IArchiveTransfer" />
      </service>
    </services>
  </system.serviceModel>
</configuration>
